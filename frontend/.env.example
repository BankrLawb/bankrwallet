# Base Sepolia (84532) or Base Mainnet (8453)
NEXT_PUBLIC_CHAIN_ID=84532

# Optional — override Coinbase Smart Wallet factory (default: v1.1 on Base)
# NEXT_PUBLIC_CSW_FACTORY_ADDRESS=0xBA5ED110eFDBa3D005bfC882d75358ACBbB85842

# Optional — defaults to public Base RPC for the selected chain
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org

# Site URL for metadata (optional)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional ERC-4337 bundler (not required for send — owner calls execute() via MetaMask)
# Pimlico — full RPC URL from dashboard (Base Sepolia example):
# NEXT_PUBLIC_BUNDLER_URL=https://api.pimlico.io/v2/84532/rpc?apikey=pim_YOUR_KEY
# Or only the API key (URL is built from NEXT_PUBLIC_CHAIN_ID):
# NEXT_PUBLIC_PIMLICO_API_KEY=pim_YOUR_KEY
# Dev without an account: https://public.pimlico.io/v2/84532/rpc

# Coinbase CDP — optional fallback bundler + OnchainKit wallet UI
# portal.cdp.coinbase.com
NEXT_PUBLIC_ONCHAINKIT_API_KEY=
